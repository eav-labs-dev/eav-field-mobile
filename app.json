{
  "expo": {
    "name": "EAV Field",
    "slug": "eav-field-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "eavfield",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.eavlabs.field"
    },
    "android": {
      "package": "dev.eavlabs.field",
      "adaptiveIcon": {
        "backgroundColor": "#E9F4EE"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
